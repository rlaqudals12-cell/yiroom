# 이룸 모바일 앱 환경변수
# .env.local 파일로 복사 후 실제 값 입력

# === Clerk 인증 ===
EXPO_PUBLIC_CLERK_PUBLISHABLE=pk_test_your-clerk-publishable-value

# === Supabase ===
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON=your-anon-value

# === Google AI (Gemini) ===
# ⚠️ 모바일에 Gemini 키를 넣지 마세요. EXPO_PUBLIC_* 는 클라이언트 번들에 평문으로
# 박힙니다. AI 분석은 전부 웹 API(lib/api/scan 등) 경유이며, 키는 웹(Vercel)의
# GOOGLE_GENERATIVE_AI_API_KEY 서버 전용 변수에만 둡니다.

# === Sentry (선택) ===
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# === EAS 빌드 ===
# EAS_PROJECT_ID는 eas.json에서 설정

# === 앱 스토어 (제출 시 필요) ===
# Apple
APPLE_ID=your-apple-id@email.com
ASC_APP_ID=your-app-store-connect-id
APPLE_TEAM_ID=your-team-id

# Google Play
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-play-key.json
