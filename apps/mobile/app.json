{
  "expo": {
    "name": "이룸",
    "slug": "yiroom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "yiroom",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF3F1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yiroom.app",
      "infoPlist": {
        "NSCameraUsageDescription": "퍼스널컬러·피부·체형·헤어·메이크업 분석 사진 촬영에 사용합니다.",
        "NSPhotoLibraryUsageDescription": "퍼스널컬러·피부·체형·헤어·메이크업 분석과 AI 아바타 생성용 사진 선택에 사용합니다."
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.yiroom.app"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EC4899"
      },
      "package": "com.yiroom.app",
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF3F1",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F0F0F"
          }
        }
      ],
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "cameraPermission": "퍼스널컬러·피부·체형·헤어·메이크업 분석 사진 촬영에 사용합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "photosPermission": "퍼스널컬러·피부·체형·헤어·메이크업 분석과 AI 아바타 생성용 사진 선택에 사용합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#EC4899"
        }
      ],
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "organization": "yiroom",
          "project": "mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0e876253-c0e1-4cbe-a9e1-33207bae230a"
      },
      "router": {}
    },
    "owner": "rlaqudals12",
    "updates": {
      "enabled": false
    }
  }
}
